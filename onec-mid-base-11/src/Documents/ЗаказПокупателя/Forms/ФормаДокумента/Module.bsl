#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// --- ДОРАБОТКА ПО ДЗ 11.2 (Начало) ---
	
	// 1. Программное добавление поля "Контактное лицо"
	// Добавляем его в ту же группу, где находится "Договор"
	ЭлементКонтактноеЛицо = Элементы.Добавить("КонтактноеЛицо", Тип("ПолеФормы"), Элементы.Договор.Родитель);
	ЭлементКонтактноеЛицо.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементКонтактноеЛицо.ПутьКДанным = "Объект.КонтактноеЛицо";
	// Сдвигаем вниз под Договор
	Элементы.Переместить(ЭлементКонтактноеЛицо, Элементы.Договор.Родитель, Элементы.Договор); 
	
	// 2. Программное добавление поля "Согласованная скидка"
	ЭлементСкидка = Элементы.Добавить("СогласованнаяСкидка", Тип("ПолеФормы"), Элементы.Договор.Родитель);
	ЭлементСкидка.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементСкидка.ПутьКДанным = "Объект.СогласованнаяСкидка";
	// Привязываем событие при изменении значения скидки
	ЭлементСкидка.УстановитьДействие("ПриИзменении", "Подключаемый_СогласованнаяСкидкаПриИзменении");
	
	// 3. Программное добавление команды и кнопки "Пересчитать скидку"
	КомандаПересчет = ЭтотОбъект.Команды.Добавить("ПересчитатьСкидку");
	КомандаПересчет.Действие = "Подключаемый_ПересчитатьСкидку";
	КомандаПересчет.Заголовок = "Пересчитать скидку";
	
	// Добавляем кнопку на главную командную панель формы
	КнопкаПересчет = Элементы.Добавить("КнопкаПересчитатьСкидку", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
	КнопкаПересчет.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	КнопкаПересчет.ИмяКоманды = "ПересчитатьСкидку";
	
	// --- ДОРАБОТКА ПО ДЗ 11.2 (Конец) ---
	
КонецПроцедуры

